{
  "name": "church-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Church Management System — modular backend APIs + modern minimal dashboard with RBAC",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter ./packages/* build && pnpm --filter ./apps/* build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "api:dev": "pnpm --filter @cms/api dev",
    "web:dev": "pnpm --filter @cms/web dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.1"
}
